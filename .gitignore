# app/build.gradle is generated by expo prebuild and patched in CI.
# It must NOT be tracked — the expo-generated version is needed for the
# com.facebook.react plugin, BOM, and rootProject.ext.* variables.
apps/mobile/android/app/build.gradle
# android/app/src/main/java/ — expo-generated Java stubs, not our code.
# Our Kotlin VPN sources are in src/main/kotlin/ and ARE tracked.
apps/mobile/android/app/src/main/java/
