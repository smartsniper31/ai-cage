# Force pnpm as package manager — prevents Codemagic/CI from using yarn or npm
engine-strict=false

# ── React Native / Expo hoisting ──────────────────────────────────────────────
# expo prebuild + Gradle resolve packages via node --print require.resolve()
# executed from android/ at Gradle config time. In a pnpm workspace, packages
# are in the virtual store (.pnpm/) and NOT visible from android/ unless they
# are hoisted to the root node_modules/.
#
# public-hoist-pattern hoists matching packages to root node_modules/ so that
# `node --print require.resolve('pkg')` works from ANY subdirectory.
#
# IMPORTANT: We must hoist BOTH the direct packages AND their sub-scopes.
# @react-native/gradle-plugin is a transitive dep of react-native — it will
# NOT be hoisted by `@react-native` alone (that only matches the scope root,
# not packages under it). We need explicit `@react-native/*` patterns.

# React Native core + all scoped sub-packages (including @react-native/gradle-plugin)
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=@react-native
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-native-*
public-hoist-pattern[]=@react-native-community/*

# Expo + all scoped sub-packages (expo prebuild, expo-modules-autolinking, etc.)
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@expo
public-hoist-pattern[]=@expo/*

# React (must be single instance across the workspace)
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom

# Navigation
public-hoist-pattern[]=@react-navigation
public-hoist-pattern[]=@react-navigation/*
